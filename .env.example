# Plantilla de variables de entorno.
# Copia este archivo como .env y rellena los valores reales.
#   PowerShell:  Copy-Item .env.example .env
#
# Los valores se obtienen en el panel de Supabase:
#   Project Settings -> API
#
# Nota: estas tres variables llevan el prefijo VITE_, por lo que Vite las
# incrusta en el bundle del navegador. Solo deben contener valores publicos.
# NUNCA pongas aqui la service_role key ni secretos de servidor.

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
